# Telegram Bot
BOT_TOKEN=your_bot_token_from_botfather
BOT_USERNAME=KaminskyAICoreBot
WEBHOOK_SECRET=random_secret_string_32chars
WEBHOOK_URL=https://kaminskyi.chat/translatorbot/webhook
ADMIN_CHAT_ID=your_telegram_user_id

# Mini App
MINI_APP_URL=https://kaminskyi.chat/translatorbot/app

# OpenAI (for glossary extraction + chatbot)
OPENAI_API_KEY=sk-your-openai-api-key

# Legacy glossary provider
DEEPL_API_KEY=your-deepl-api-key

# Document translation
OTRANSLATOR_API_KEY=your-otranslator-api-key
OTRANSLATOR_MODEL=gemini-3.1-thinking
OTRANSLATOR_VALIDATE_MODEL=1
OTRANSLATOR_GLOSSARY_NAME=C-Sailor_Pro_Glossary_EN-UK-1
OTRANSLATOR_POLL_INTERVAL=3
OTRANSLATOR_MAX_POLL_TIME=900

# Access control
ALLOWED_TELEGRAM_IDS=*
INTERNAL_API_KEY=random_internal_processor_secret
PROCESSOR_URL=http://processor:5000

# Stripe (for invoicing)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Server
PORT=8080
DATA_DIR=/data
DB_PATH=/data/db/bot.db
ENVIRONMENT=production
